<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unsubscribe</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
            background-color: #000;
        }
        #contact-section {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            text-align: center;
        }
        .video-bg {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: -1;
        }
        .video-bg video {
            width: 100%; height: 100%;
            object-fit: cover;
            pointer-events: none;
        }
        .unsubscribe-content {
            background-color: rgba(0,0,0,0.7);
            padding: 32px;
            border-radius: 28px;
            max-width: 400px;
            width: 90%;
            box-sizing: border-box;
        }
        .unsubscribe-content h2 {
            font-size: 2rem;
            margin-bottom: 20px;
            font-weight: 200;
        }
        .unsubscribe-form input {
            width: 100%;
            padding: 12px;
            border-radius: 20px;
            border: none;
            font-size: 1rem;
        }
        .unsubscribe-buttons {
            display: flex;
            gap: 12px;
            margin-top: 12px;
        }
        .unsubscribe-buttons button {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 40px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 200;
        }
        .btn-unsubscribe {
            background-color: #e74c3c;
            color: white;
        }
        .btn-site {
            background-color: #2ecc71;
            color: white;
        }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;400;500&display=swap" rel="stylesheet">
</head>
<body>
    <section id="contact-section">
        <div class="video-bg">
            <video autoplay muted loop playsinline preload="auto">
                <source src="media/video.mp4" type="video/mp4">
                Your browser does not support video.
            </video>
        </div>
        <div class="unsubscribe-content">
            <h2>Unsubscribe ?</h2>
            <form class="unsubscribe-form">
                <input type="email" placeholder="Enter your email" required>
                <div class="unsubscribe-buttons">
                    <button type="submit" class="btn-unsubscribe">Unsubscribe</button>
                    <button type="button" class="btn-site">Look site!</button>
                </div>
            </form>
        </div>
    </section>
</body>
</html>

